# MJ MCP Layer — Environment Variable Handoff
# Do not commit live values. Configure these as GitHub Actions secrets or local shell exports.

# Required GitHub Actions secrets
# - CF_API_TOKEN: Cloudflare API token scoped for Worker deploy, D1 migration, and zone hardening.
# - CF_ACCOUNT_ID: Cloudflare account id used by Wrangler and audit/scan scripts.
# - CF_ZONE_ID_ELLIS: Cloudflare zone id for ellis-aegis.us.
# - CF_ZONE_ID_HITCH: Cloudflare zone id for hitch.guru.
# - CF_ZONE_ID_KEVIS: Cloudflare zone id for kevis.online.
# - OPERATOR_TOKEN: Operator bearer/header token used by Worker smoke tests.
# - MCP_SMOKE_BASE_URL: Optional smoke-test base URL. Defaults to https://mcp.ellis-aegis.us in CI.
# - MCP_LEDGER_KEY: Production signing key for ledger, visa, court, and evidence signatures.

# Local development exports only. Keep values out of git.
export CF_API_TOKEN="set-in-shell-or-gh-secret"
export CF_ACCOUNT_ID="set-in-shell-or-gh-secret"
export CF_ZONE_ID="set-in-shell-or-gh-secret"
export OPERATOR_TOKEN="set-in-shell-or-gh-secret"
export MCP_LEDGER_KEY="set-in-shell-or-gh-secret"

# Optional provider adapters remain disabled unless explicitly configured.
# export AWS_REGION="us-east-1"
# export AWS_ACCESS_KEY_ID="set-in-shell-or-gh-secret"
# export AWS_SECRET_ACCESS_KEY="set-in-shell-or-gh-secret"
# export K8S_CLUSTER="prod-us-east"
# export KUBECONFIG="path-to-local-kubeconfig"
