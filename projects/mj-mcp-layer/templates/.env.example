# MJ MCP Layer — Environment Variables
# Copy to projects/mj-mcp-layer/.env and fill in values.

# Cloudflare API credentials (required)
CF_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CF_ZONE_ID=YOUR_ZONE_ID

# Optional: Cloudflare account ID (enables audit log scanning)
CF_ACCOUNT_ID=

# Optional: alternate naming convention
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Platform CLI
MCP_LEDGER_KEY=your-signing-key-here

# AWS (if using AWS adapter)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Kubernetes (if using Kubernetes adapter)
# K8S_CLUSTER=prod-us-east
# KUBECONFIG=
