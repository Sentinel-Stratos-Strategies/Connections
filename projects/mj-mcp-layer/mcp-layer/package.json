{
  "name": "mj-mcp-layer",
  "version": "1.0.0",
  "private": true,
  "description": "MJ MCP Edge Layer — Multi-tenant policy enforcement, MCP routing, and control plane Worker.",
  "scripts": {
    "build": "tsc --noEmit",
    "build:dashboard": "NEXT_PUBLIC_MCP_BASE_URL=https://mcp.ellis-aegis.us npm --prefix ../dashboard run build",
    "build:dashboard:local": "NEXT_PUBLIC_MCP_BASE_URL=http://localhost:8787 npm --prefix ../dashboard run build",
    "dev": "wrangler dev",
    "dev:local": "npm run build:dashboard:local && wrangler dev --config wrangler.local.jsonc --port 8787",
    "deploy": "npm run build:dashboard && wrangler deploy",
    "deploy:dry-run": "npm run build:dashboard && wrangler deploy --dry-run",
    "lint": "tsc --noEmit",
    "manifest:deployment": "node scripts/write-deployment-manifest.mjs",
    "smoke": "node scripts/smoke-control-plane.mjs",
    "smoke:enterprise-lanes": "node scripts/smoke-enterprise-lanes.mjs",
    "tail": "wrangler tail",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260101.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.76.0"
  }
}
