{
  "lane": "mj-antigravity",
  "platform": "antigravity",
  "purpose": "Enable Antigravity app to act as an approved AI/dev control surface and MCP operator for code authoring, project context, and approved tool calls through the MJ control plane.",
  "owner": "Sentinel",
  "authMode": "mcp_connector",
  "memoryMode": "projection_only",
  "allowedActions": [
    "code.read",
    "code.plan",
    "code.patch_propose",
    "project.context_read",
    "mcp.connector.list",
    "mcp.connector.call_approved",
    "thread.create",
    "thread.read",
    "tool.call_approved",
    "bridge.command.prepare"
  ],
  "deniedActions": [
    "hidden_endpoint.call",
    "unauthorized_ui_automation",
    "secret.read",
    "policy_control.bypass",
    "login_history.recover_deleted",
    "bulk_file_delete",
    "production_deploy_without_approval"
  ],
  "requiresAudit": true,
  "requiresApprovalFor": [
    "code.patch_apply",
    "mcp.connector.add_external",
    "bridge.push_production",
    "file.write_production",
    "repo.settings_update"
  ],
  "dataBoundaries": {
    "externalRead": "approved_local_and_connector_scope_only",
    "externalWrite": "explicit_user_triggered_only",
    "truthWrite": "denied",
    "secretHandling": "never_return_secret_values",
    "logPayloads": false
  },
  "mcpConnection": {
    "transport": "http",
    "endpoint": "https://mcp.ellis-aegis.us/mcp",
    "requiredHeaders": {
      "x-tenant-id": "kevis",
      "x-policy-version": "mj-edge-unified-v2",
      "x-operator-capability": "mcp.admin",
      "x-request-id": "generated_per_request"
    },
    "authHeader": "x-ellis-aegis-token",
    "authScheme": "Bearer"
  }
}
