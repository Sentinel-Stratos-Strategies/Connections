    {
      "lane": "mj-github",
      "status": "ready_for_app_or_oidc",
      "entrypoint": "https://mcp.ellis-aegis.us/mcp",
      "requiredSecrets": ["GITHUB_TOKEN or GitHub App credentials"],
      "requiredHeaders": ["x-tenant-id", "x-request-id", "x-policy-version", "x-operator-capability"],
      "allowedCapabilities": ["repo.read", "pr.comment", "workflow.dispatch"],
      "auditMode": "required"
    },
    {
      "lane": "mj-cloudflare",
      "status": "ready_for_api_token",
      "entrypoint": "https://mcp.ellis-aegis.us/mcp",
      "requiredSecrets": ["CF_API_TOKEN", "CF_ACCOUNT_ID", "CF_ZONE_ID_ELLIS", "CF_ZONE_ID_HITCH", "CF_ZONE_ID_KEVIS"],
