      "allowedCapabilities": ["cloud.ops", "security.status", "forensic.read"],
      "auditMode": "required"
    },
    {
      "lane": "mj-openai",
      "status": "ready_for_connector_scope",
      "entrypoint": "https://mcp.ellis-aegis.us/mcp",
