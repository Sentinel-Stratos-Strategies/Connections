{
  "$schema": "../schemas/infrastructure-connections.schema.json",
  "version": 1,
  "authority": {
    "account": "5b94eedaff8fb3ccaa1b607f57963e10",
    "zone": "ellis-aegis.us",
    "worker": "mj-edge",
    "entrypoints": [
      "https://mj.ellis-aegis.us",
      "https://mcp.ellis-aegis.us",
