      "allowedCapabilities": ["doc.read", "doc.update_approved"],
      "auditMode": "required"
    },
    {
      "lane": "mj-linear",
      "status": "ready_for_connector_scope",
      "entrypoint": "https://mcp.ellis-aegis.us/mcp",
      "requiredSecrets": ["LINEAR_API_KEY or approved Linear connector"],
      "requiredHeaders": ["x-tenant-id", "x-request-id", "x-policy-version", "x-operator-capability"],
      "allowedCapabilities": ["issue.read", "issue.update_approved"],
      "auditMode": "required"
